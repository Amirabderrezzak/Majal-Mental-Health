# ── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ── Vercel Serverless Functions ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
WEBHOOK_SECRET=generate-a-random-secret
FRONTEND_URL=https://your-domain.com
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Majal <noreply@your-domain.com>
DAILY_API_KEY=your-daily-api-key

# ── Payment Gateway: SofizPay (CIB / Edahabia) ──────────────────────────────
# Get your secret key from the SofizPay mobile app (Settings → View Secret Key)
# Leave empty to use mock mode for development
SOFIZPAY_SECRET_KEY=

# ── Optional: Twilio ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ── Optional: Firebase Cloud Messaging (Push Notifications) ──────────────────
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_VAPID_KEY=your-vapid-key
