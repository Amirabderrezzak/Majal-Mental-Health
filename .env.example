# ── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ── Vercel Serverless Functions ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
WEBHOOK_SECRET=generate-a-random-secret
FRONTEND_URL=https://your-domain.com
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Majal <noreply@your-domain.com>
DAILY_API_KEY=your-daily-api-key

# ── Payment Gateway: SofizPay (CIB / Edahabia) ──────────────────────────────
# Public Key: from SofizPay app → Receive → copy public key (starts with G)
# Secret Key: from SofizPay app → Settings → View Secret Key (starts with S)
# Set SOFIZPAY_SANDBOX=true to test with sandbox test cards
# Leave SOFIZPAY_PUBLIC_KEY empty to use mock mode for development
SOFIZPAY_PUBLIC_KEY=
SOFIZPAY_SECRET_KEY=
SOFIZPAY_SANDBOX=true

# ── Web Push (VAPID) — used by api/notifications.ts via web-push ─────────────
# Generate a VAPID keypair (npx web-push generate-vapid-keys) and paste here.
# NOTE: variables are named "FIREBASE_*" for historical reasons but are consumed
# by the web-push library, not Firebase.
VITE_FIREBASE_VAPID_KEY=your-vapid-public-key
FIREBASE_VAPID_PRIVATE_KEY=your-vapid-private-key
FIREBASE_VAPID_MAILTO=mailto:admin@majalpsy.com
